# Keep the WordPress hosting backup out of the GitHub Pages repository.
*.zip
*-installer-backup.php
dup-installer/
wp-admin/
wp-includes/
cgi-bin/
*.sql
wp-config.php
wp-content/wflogs/

# Event API schema is source; local credentials are not.
!backend/schema.sql
backend/.dev.vars
backend/.env
backend/.env.*
backend/.wrangler/
